<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F14"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:background="#1A1A24"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FAST CLIENT v1.0"
            android:textColor="#00FFCC"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/user_name_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Offline Username"
            android:textColorHint="#666"
            android:textColor="#FFF"
            android:background="#12121A"
            android:padding="10dp"
            android:textSize="14sp"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/server_ip_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Aternos Server IP"
            android:textColorHint="#666"
            android:textColor="#FFF"
            android:background="#12121A"
            android:padding="10dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="PLAY MINECRAFT"
            android:textStyle="bold"
            android:textColor="#000"
            android:backgroundTint="#00FFCC"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/fast_ping_button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="FAST SERVER PING"
            android:textSize="12sp"
            android:backgroundTint="#2D2D3D"
            android:textColor="#FFF"/>

    </LinearLayout>

</RelativeLayout>
